From f73c167b4b15a37160f472cb18ff19526c74a52f Mon Sep 17 00:00:00 2001
From: Miro Kropacek <miro.kropacek@gmail.com>
Date: Fri, 31 Jul 2026 11:39:17 +1000
Subject: [PATCH 3/6] COMMON: Fix isAppleDouble out param of
 disassembleAppleDoubleName()

The parameter was initialized to false but never set to true when the
"._" prefix was actually stripped. As a consequence, the AppleDouble
branch in MacResManager::listFiles() was dead code and AppleDouble
files were listed under their decorated names.
---
 common/macresman.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/common/macresman.cpp b/common/macresman.cpp
index 72f7a8eb127..f18f34d9de4 100644
--- a/common/macresman.cpp
+++ b/common/macresman.cpp
@@ -1170,6 +1170,9 @@ Path MacResManager::disassembleAppleDoubleName(const Path &name, bool *isAppleDo
 	if (name.isSeparatorTerminated()) {
 		ret.appendInPlace("/");
 	}
+	if (isAppleDouble) {
+		*isAppleDouble = true;
+	}
 	return ret;
 }
 
