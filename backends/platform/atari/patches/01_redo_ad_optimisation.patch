From 7043fcf641c694dc0705432da8b98aa1751484ec Mon Sep 17 00:00:00 2001
From: Miro Kropacek <miro.kropacek@gmail.com>
Date: Fri, 31 Jul 2026 11:40:06 +1000
Subject: [PATCH 6/6] AD: Consider decorated Macintosh file names in early
 rejection

The early-rejection optimization compared directory file names against
the detection entry names literally. Macintosh games, however, are often
stored under decorated names (MacBinary ".bin", raw resource fork or
AppleDouble ".rsrc", AppleDouble "._" prefix) which MacResManager
resolves transparently once the MD5s are computed, so such games were
wrongly rejected before that could happen. This is what caused bug
#17026 and the revert in commit 8af3ca44e36.

Fix this by also looking up the undecorated form of each on-disk name,
as computed by MacResManager::disassembleName(). Unlike enumerating
every possible on-disk variant of the detection entries, as attempted in
PR #7756, this is much safer: in the worst case we match more files than
needed.
---
 engines/advancedDetector.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/engines/advancedDetector.cpp b/engines/advancedDetector.cpp
index 1433f0e9021..592a50c33f3 100644
--- a/engines/advancedDetector.cpp
+++ b/engines/advancedDetector.cpp
@@ -763,6 +763,13 @@ ADDetectedGames AdvancedMetaEngineDetectionBase::detectGame(const Common::FSNode
 			anyFileFound = true;
 			break;
 		}
+
+		bool isMacDecoratedName = false;
+		Common::Path undecorated = Common::MacResManager::disassembleName(it->_key, &isMacDecoratedName);
+		if (isMacDecoratedName && _fileNamesMap.contains(undecorated)) {
+			anyFileFound = true;
+			break;
+		}
 	}
 	if (!anyFileFound) {
 		debugC(3, kDebugGlobalDetection, "Skipping engine '%s': no matching file names in directory", getName());
-- 
