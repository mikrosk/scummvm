index 015ae50f7eb..52b4f969cae 100644
--- a/backends/platform/atari/module.mk
+++ b/backends/platform/atari/module.mk
@@ -4,6 +4,7 @@ MODULE_OBJS := \
 	osystem_atari.o \
 	atari_ikbd.o \
 	native_features.o \
