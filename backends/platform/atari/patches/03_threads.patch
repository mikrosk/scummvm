+2:	rts
 
 SYM(atari_mutex_unlock):
+	tst.l	_thread_func(pc)		/* threads running? */
+	beq.b	1f
 #ifndef __FASTCALL__
 	move.l	4(sp),a0
 #endif
@@ -357,5 +376,6 @@ SYM(atari_mutex_unlock):
